# Installed by rootmote-agent installer at /etc/sudoers.d/rootmote-agent-firewall.
#
# The agent runs as the unprivileged `rootmote` user. Firewall management
# (ufw / firewall-cmd), host webserver config validation, host reboot,
# terminating a suspicious process found by the security audit (which is
# usually owned by root or another service account, not `rootmote`), enabling
# auditd as a narrow security-hardening remediation, and storage cleanup's
# file/journal deletion (rootmote-agent.service's ProtectSystem=strict mounts
# everything outside ReadWritePaths=/var/lib/rootmote /etc/caddy/rootmote
# read-only) require root, so we grant passwordless NOPASSWD access to just
# those fixed commands. All mutations still go through the agent's biometric +
# confirmation-token + anti-lockout pipeline before any sudo call is made.
#
# There is deliberately NO shell grant (`sh -c`, `bash -c`) and NO generic
# `rm` grant in this file. AI-authored raw scripts are never executed by the
# agent; they are shown to the operator as advice to run themselves. Every
# rule below is a fixed argv, except:
#   - `kill -TERM|-KILL <pid>` (the agent re-checks pid + start time first),
#   - `caddy validate --config <file>` (read-only validation), and
#   - the `storage-rm` helper's path argument, validated in Go as root.
#
# The storage and package rules route through `nsenter --mount=/proc/1/ns/mnt`
# because a plain sudo-escalated child inherits the calling process's mount
# namespace — it would still see ProtectSystem=strict's read-only bind mounts
# even as root. Joining PID 1's real, unsandboxed mount namespace first is
# what actually reaches the rest of the host filesystem.
#
# Visudo syntax: use `Defaults!cmnd setenv` would re-enable env leakage;
# keep the default env_reset.
rootmote ALL=(root) NOPASSWD: /usr/sbin/ufw, /sbin/ufw, /usr/bin/firewall-cmd, /bin/firewall-cmd
rootmote ALL=(root) NOPASSWD: /usr/bin/systemctl reboot, /bin/systemctl reboot
rootmote ALL=(root) NOPASSWD: /usr/sbin/nginx -t, /sbin/nginx -t
rootmote ALL=(root) NOPASSWD: /usr/sbin/apache2ctl configtest, /usr/bin/apache2ctl configtest, /usr/sbin/apachectl configtest, /usr/bin/apachectl configtest
rootmote ALL=(root) NOPASSWD: /usr/sbin/httpd -t, /usr/bin/httpd -t, /sbin/httpd -t
rootmote ALL=(root) NOPASSWD: /usr/bin/caddy validate, /usr/bin/caddy validate --config *, /usr/local/bin/caddy validate, /usr/local/bin/caddy validate --config *
rootmote ALL=(root) NOPASSWD: /bin/kill -TERM *, /bin/kill -KILL *, /usr/bin/kill -TERM *, /usr/bin/kill -KILL *
rootmote ALL=(root) NOPASSWD: /usr/bin/nsenter --mount=/proc/1/ns/mnt -- /usr/bin/apt-get install -y auditd, /bin/nsenter --mount=/proc/1/ns/mnt -- /usr/bin/apt-get install -y auditd
rootmote ALL=(root) NOPASSWD: /usr/bin/nsenter --mount=/proc/1/ns/mnt -- /usr/bin/dnf install -y audit, /bin/nsenter --mount=/proc/1/ns/mnt -- /usr/bin/dnf install -y audit
rootmote ALL=(root) NOPASSWD: /usr/bin/nsenter --mount=/proc/1/ns/mnt -- /usr/bin/yum install -y audit, /bin/nsenter --mount=/proc/1/ns/mnt -- /usr/bin/yum install -y audit
rootmote ALL=(root) NOPASSWD: /usr/bin/nsenter --mount=/proc/1/ns/mnt -- /sbin/apk add audit, /bin/nsenter --mount=/proc/1/ns/mnt -- /sbin/apk add audit
rootmote ALL=(root) NOPASSWD: /usr/bin/nsenter --mount=/proc/1/ns/mnt -- /usr/bin/systemctl enable --now auditd, /bin/nsenter --mount=/proc/1/ns/mnt -- /usr/bin/systemctl enable --now auditd

# Storage cleanup. Deletion goes through the agent binary's own `storage-rm`
# helper, which re-validates its arguments as root (exactly <-f|-rf> <path>,
# absolute, no `..`, never a system directory or an ancestor of one) and
# deletes with os.Remove/os.RemoveAll — no `rm`, no shell. Only the installed
# binary path is granted. The journal vacuum target is a fixed size.
rootmote ALL=(root) NOPASSWD: /usr/bin/nsenter --mount=/proc/1/ns/mnt -- /usr/local/bin/rootmote-agent storage-rm -f *, /usr/bin/nsenter --mount=/proc/1/ns/mnt -- /usr/local/bin/rootmote-agent storage-rm -rf *
rootmote ALL=(root) NOPASSWD: /bin/nsenter --mount=/proc/1/ns/mnt -- /usr/local/bin/rootmote-agent storage-rm -f *, /bin/nsenter --mount=/proc/1/ns/mnt -- /usr/local/bin/rootmote-agent storage-rm -rf *
rootmote ALL=(root) NOPASSWD: /usr/bin/nsenter --mount=/proc/1/ns/mnt -- /usr/bin/journalctl --vacuum-size=200M, /usr/bin/nsenter --mount=/proc/1/ns/mnt -- /bin/journalctl --vacuum-size=200M
rootmote ALL=(root) NOPASSWD: /bin/nsenter --mount=/proc/1/ns/mnt -- /usr/bin/journalctl --vacuum-size=200M, /bin/nsenter --mount=/proc/1/ns/mnt -- /bin/journalctl --vacuum-size=200M
